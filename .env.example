# Optional local overrides. Copy this file to .env if needed.
COMPOSE_PROJECT_NAME=il05
KAFKA_PORT=29092
HDFS_UI_PORT=9870
# Apache Spark image, including Python. All teammates can use this default.
SPARK_IMAGE=apache/spark:3.5.1
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
AIRFLOW_PORT=18082
SUPERSET_PORT=8088
# Enable with: docker compose --profile part4 up --build -d
# To enable Part 4 for ordinary `docker compose up`, uncomment:
# COMPOSE_PROFILES=part4
