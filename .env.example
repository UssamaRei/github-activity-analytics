# Optional local overrides. Copy this file to .env if needed.
COMPOSE_PROJECT_NAME=il05
KAFKA_PORT=29092
HDFS_UI_PORT=9870
# Apache Spark image, including Python. All teammates can use this default.
SPARK_IMAGE=apache/spark:3.5.1
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
AIRFLOW_PORT=18082
SUPERSET_PORT=8088
# All platform services start with: docker compose up --build -d
# Optional standalone Silver processing: docker compose run --rm spark-silver
# Optional GitHub language enrichment token. Keep its value only in local .env.
# GITHUB_TOKEN=
